#!/bin/bash

set -x

# Read the instance UUID from a file generated by cloud-init. This file is generated
# whether the metadata source is the metadata HTTP service or config-drive
UUID=$(</var/lib/cloud/data/instance-id)
# We set the host as the UUID in case there are VMs with duplicte IP addresses
# Such as 192.168.X.Y or 10.10.X.Y
/usr/sbin/pakiti3 --url "https://pakiti.stfc.ac.uk/feed/" --site Cloud --host "$UUID"
